# Diagnostic Package Choices
#-----------------
# for each output-stream:
#  filename(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  frequency(n):< 0 : write snap-shot output every |frequency| seconds
#               > 0 : write time-average output every frequency seconds
#  timePhase(n)     : write at time = timePhase + multiple of |frequency|
#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
#                 when this entry is missing, select all common levels of this list
#  fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics.log"
#                 file for the list of all available diag. in this particular config)
#-----------------
 &diagnostics_list
# diag_mnc     = .FALSE.,
# do not specify levels => all levels are selected
#  monthly do 2628000.0,
#---
   frequency(1) = 86400.0,
   fields(1,1) = 'THETA   ',
                 'SALT    ',
                 'UVEL    ',
                 'VVEL    ',
                 'WVEL    ',
                 'PHIHYD  ',
                 'DRHODR  ',
                 'UVELMASS', 'VVELMASS', 'WVELMASS',
   filename(1) = 'diag_state',
#
    frequency(2) = 86400.0,
    fields(1,2) = 'TRAC01  ',
                  'TRAC02  ',
                  'TRAC03  ',
                  'TRAC04  ',
                  'TRAC05  ',
                  'TRAC06  ',
                  'TRAC07  ',
                  'TRAC08  ',
                  'TRAC09  ',
                  'BLGPH3D ',
                  'BLGOMAR ',
                  'BLGFESED',
#                  'BLGFEUP ','BLGFESPM','BLGFEREM','BLGFERD ','BLGFEREC',
#                  'BLGFEADI','BLGFEADO','GC_Tr06 ',
                  'KPPviscA','KPPdiffS','KPPghatK','KPPRi   ',
    filename(2) = 'diag_bgc',
#                    
    frequency(3) = 86400.0,
    fields(1,3) = 'ETAN    ',
                  'BLGPCO2 ',
                  'SIarea  ',
                  'SIheff  ',
                  'PHIBOT  ',
                  'BLGO2SAT',
                  'BLGCHLSA',
                  'SIuice  ',
                  'SIvice  ',
                  'SIuheff ',
                  'SIvheff ',
#                  'SItr01  ',
                  'SIhsnow ',
                  'BLGMLD  ',
#                  'SIdHbOCN',
#                  'SIdSbATC',
#                  'SIdSbOCN',
#                  'SIdHbATC',
#                  'SIdHbATO',
#                  'SIdHbFLO', 
#                  'SIdA    ', 
                  'ADVxHEFF', 'ADVyHEFF', 'ADVxAREA', 'ADVyAREA', 
                  'ADVxSNOW', 'ADVySNOW',  
                  'SHIfwFlx', 'SHIhtFlx',
                  'BLGSURFE','BLGFEBUR',
                  'KPPhbl  ',
      filename(3) = 'diag_surf',
#
    frequency(4) = 86400.0,
    fields(1,4) = 'TFLUX   ',
                  'SFLUX   ', 
                  'BLGCFLX ',
                  'BLGOFLX ',
#                  'Add2EmP ',
                  'oceTAUX ',
                  'oceTAUY ',
                  'oceFWflx',
                  'oceSflux',
                  'oceQnet ',
                  'oceQsw  ',
                  'oceFreez',
                  'oceSPflx',
                  'SIempmr ',
                  'SIatmFW ',
                  'BLGSURFE',
                  'SIqnet  ','SIqsw   ','SIatmQnt','SItflux',
    filename(4) = 'diag_airsea',
#
   frequency(5) = 86400.0,
   fields(1,5) = 'BLGNCP  ',
                 'BLGNPP  ',
                 'BLGNFIX ',
                 'BLGCHL  ',
                 'BLGPSM  ',
                 'BLGPLG  ',
                 'BLGPOC  ',
                 'BLGPDIA ',
                 'BLGMU   ',
                 'BLGMUDIA',
                 'BLGFELIM',
                 'BLGNLIM ',
                 'BLGPLIM ',
                 'BLGLLIM ',
                 'BLGIRRIS',
   filename(5) = 'ZZdiag_bio',
#
#---
 /
#
# Parameter for Diagnostics of per level statistics:
#-----------------
# for each output-stream:
#  stat_fname(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics.log"
#                 file for the list of all available diag. in this particular config)
#-----------------
 &DIAG_STATIS_PARMS
# an example just to check the agreement with MONITOR output:
# stat_fields(1,1)= 'ETAN    ','UVEL    ','VVEL    ','WVEL    ', 'THETA   ',
#    stat_fname(1)= 'dynStDiag',
#     stat_freq(1)= -432000.,
#    stat_phase(1)= 0.,
 /
